# Copy to .env and fill in. Keys can also be added later in the app: Superadmin → AI, voice and defaults → Integrations.
DATABASE_URL=mysql+pymysql://code2hire:code2hire@localhost:3306/code2hire?charset=utf8mb4
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
TOKEN_TTL_HOURS=12

# Anthropic: every AI task (job drafts, screening, interviews, Isha live analysis, reports, Disha)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Azure Speech: Hira's voice (TTS) and speech-to-text for candidates and Isha
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# true = deterministic built-in answers when no Anthropic key is set (demo / offline)
AI_FALLBACK=true
